-- ================== SPEED HACK ==================
local speedHackEnabled = false
local currentSpeed = 16
local speedConnection = nil
local toolConnections = {}
local speedUpdateConnection = nil

local function applySpeed(speed)
	local targetSpeed = speed or currentSpeed
	currentSpeed = targetSpeed
	
	if player.Character then
		local humanoid = player.Character:FindFirstChild("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = targetSpeed
		end
	end
end

local function updateSpeed(speed)
	currentSpeed = speed
	applySpeed(speed)
end

local function clearToolConnections()
	for _, connection in ipairs(toolConnections) do
		connection:Disconnect()
	end
	toolConnections = {}
end

local function setupToolTracking(character)
	if not character then return end
	
	clearToolConnections()
	
	local childAddedConn = character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and speedHackEnabled then
			local startTime = tick()
			local restoreConnection
			restoreConnection = RunService.Heartbeat:Connect(function()
				if tick() - startTime > 0.5 then
					restoreConnection:Disconnect()
					return
				end
				if speedHackEnabled and player.Character then
					local humanoid = player.Character:FindFirstChild("Humanoid")
					if humanoid and humanoid.WalkSpeed ~= currentSpeed then
						humanoid.WalkSpeed = currentSpeed
					end
				end
			end)
		end
	end)
	
	local childRemovedConn = character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") and speedHackEnabled then
			local startTime = tick()
			local restoreConnection
			restoreConnection = RunService.Heartbeat:Connect(function()
				if tick() - startTime > 0.5 then
					restoreConnection:Disconnect()
					return
				end
				if speedHackEnabled and player.Character then
					local humanoid = player.Character:FindFirstChild("Humanoid")
					if humanoid and humanoid.WalkSpeed ~= currentSpeed then
						humanoid.WalkSpeed = currentSpeed
					end
				end
			end)
		end
	end)
	
	table.insert(toolConnections, childAddedConn)
	table.insert(toolConnections, childRemovedConn)
end

local function toggleSpeedHack(state, speed)
	speedHackEnabled = state
	
	if state then
		local targetSpeed = speed or currentSpeed
		currentSpeed = targetSpeed
		
		applySpeed(targetSpeed)
		
		if player.Character then
			setupToolTracking(player.Character)
		end
		
		if speedUpdateConnection then speedUpdateConnection:Disconnect() end
		
		speedUpdateConnection = RunService.Heartbeat:Connect(function()
			if not speedHackEnabled then
				speedUpdateConnection:Disconnect()
				return
			end
			
			if player.Character then
				local humanoid = player.Character:FindFirstChild("Humanoid")
				if humanoid and humanoid.WalkSpeed ~= currentSpeed then
					humanoid.WalkSpeed = currentSpeed
				end
			end
		end)
		
		if speedConnection then speedConnection:Disconnect() end
		
		speedConnection = player.CharacterAdded:Connect(function(character)
			task.wait(0.1)
			if speedHackEnabled then
				applySpeed(currentSpeed)
				setupToolTracking(character)
			end
		end)
	else
		if player.Character then
			local humanoid = player.Character:FindFirstChild("Humanoid")
			if humanoid then humanoid.WalkSpeed = 16 end
		end
		
		clearToolConnections()
		
		if speedUpdateConnection then
			speedUpdateConnection:Disconnect()
			speedUpdateConnection = nil
		end
		
		if speedConnection then
			speedConnection:Disconnect()
			speedConnection = nil
		end
	end
end

