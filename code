local function switchCategory(categoryName)
	if currentCategory == categoryName then return end
	
	for _, frame in pairs(categoryFrames) do
		frame.Visible = false
	end
	
	for _, button in pairs(categoryButtons) do
		button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		button.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
	
	if categoryFrames[categoryName] then
		categoryFrames[categoryName].Visible = true
	end
	
	if categoryButtons[categoryName] then
		categoryButtons[categoryName].BackgroundColor3 = Color3.fromRGB(60, 60, 60)
		categoryButtons[categoryName].TextColor3 = Color3.fromRGB(255, 255, 255)
	end
	
	currentCategory = categoryName
end

