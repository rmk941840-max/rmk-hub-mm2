local function createInputSection(categoryName, name, defaultValue, minValue, maxValue, callback)
	local targetFrame = categoryFrames[categoryName]
	if not targetFrame then return end
	
	local sectionFrame = Instance.new("Frame")
	sectionFrame.Name = name .. "_Section"
	sectionFrame.Size = UDim2.new(1, -20, 0, 40)
	sectionFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	sectionFrame.BorderSizePixel = 0
	sectionFrame.Parent = targetFrame

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(0, 140, 1, 0)
	nameLabel.Position = UDim2.new(0, 12, 0, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamSemibold
	nameLabel.Text = name
	nameLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
	nameLabel.TextSize = 15
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = sectionFrame

	local inputBox = Instance.new("TextBox")
	inputBox.Name = "InputBox"
	inputBox.Size = UDim2.new(0, 70, 0, 24)
	inputBox.Position = UDim2.new(1, -80, 0.5, -12)
	inputBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	inputBox.BorderSizePixel = 0
	inputBox.Font = Enum.Font.Gotham
	inputBox.Text = tostring(defaultValue)
	inputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	inputBox.TextSize = 14
	inputBox.PlaceholderText = minValue .. "-" .. maxValue
	inputBox.PlaceholderColor3 = Color3.fromRGB(100, 100, 100)
	inputBox.Parent = sectionFrame

	local currentValue = defaultValue

	inputBox:GetPropertyChangedSignal("Text"):Connect(function()
		local num = tonumber(inputBox.Text)
		if num and num >= minValue and num <= maxValue then
			currentValue = num
			inputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
			if callback then
				callback(num)
			end
		end
	end)

	inputBox.FocusLost:Connect(function(enterPressed)
		local num = tonumber(inputBox.Text)
		if not num or num < minValue or num > maxValue then
			inputBox.Text = tostring(currentValue)
			inputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end)

	return {
		InputBox = inputBox,
		GetValue = function() return currentValue end,
		SetValue = function(val)
			if val >= minValue and val <= maxValue then
				currentValue = val
				inputBox.Text = tostring(val)
			end
		end,
	}
end

