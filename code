	nameLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
	nameLabel.TextSize = 15
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = sectionFrame

	local toggleButton = Instance.new("TextButton")
	toggleButton.Name = "Toggle"
	toggleButton.Size = UDim2.new(0, 50, 0, 24)
	toggleButton.Position = UDim2.new(1, -58, 0.5, -12)
	toggleButton.BackgroundColor3 = defaultState and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(80, 80, 80)
	toggleButton.BorderSizePixel = 0
	toggleButton.Font = Enum.Font.GothamBold
	toggleButton.Text = ""
	toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	toggleButton.TextSize = 11
	toggleButton.AutoButtonColor = false
	toggleButton.Parent = sectionFrame

	local toggleFrame = Instance.new("Frame")
	toggleFrame.Name = "ToggleKnob"
	toggleFrame.Size = UDim2.new(0, 20, 0, 20)
	toggleFrame.Position = defaultState and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
	toggleFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	toggleFrame.BorderSizePixel = 0
	toggleFrame.Parent = toggleButton

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Size = UDim2.new(0, 45, 0, 16)
	statusLabel.Position = UDim2.new(1, -110, 0.5, -8)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Font = Enum.Font.Gotham
	statusLabel.Text = defaultState and "ON" or "OFF"
	statusLabel.TextColor3 = defaultState and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(150, 150, 150)
	statusLabel.TextSize = 12
	statusLabel.TextXAlignment = Enum.TextXAlignment.Right
	statusLabel.Parent = sectionFrame

	local state = defaultState

	local function updateVisual()
		if state then
			toggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 100)
			statusLabel.Text = "ON"
			statusLabel.TextColor3 = Color3.fromRGB(0, 170, 100)
			toggleFrame:TweenPosition(
				UDim2.new(1, -22, 0.5, -10),
				Enum.EasingDirection.Out,
				Enum.EasingStyle.Quad,
				0.15,
				true
			)
		else
			toggleButton.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
			statusLabel.Text = "OFF"
			statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
			toggleFrame:TweenPosition(
				UDim2.new(0, 2, 0.5, -10),
				Enum.EasingDirection.Out,
				Enum.EasingStyle.Quad,
				0.15,
				true
			)
		end
	end

	toggleButton.MouseButton1Click:Connect(function()
		state = not state
		updateVisual()
		if callback then
			callback(state)
		end
	end)

	return {
		ToggleButton = toggleButton,
		ToggleFrame = toggleFrame,
		StatusLabel = statusLabel,
		GetState = function() return state end,
		SetState = function(newState)
			state = newState
			updateVisual()
		end,
	}
end

