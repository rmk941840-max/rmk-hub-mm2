-- ================== ESP СИСТЕМА С РОЛЯМИ ==================
local espEnabled = false
local espFolder = Instance.new("Folder")
espFolder.Name = "ESP_Folder"
espFolder.Parent = workspace

local espObjects = {}

local function getPlayerRole(targetPlayer)
	local character = targetPlayer.Character
	if not character then return "Innocent" end
	
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			local toolName = child.Name:lower()
			if toolName:find("knife") then return "Murder" end
			if toolName:find("gun") then return "Sheriff" end
		end
	end
	
	local backpack = targetPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if child:IsA("Tool") then
				local toolName = child.Name:lower()
				if toolName:find("knife") then return "Murder" end
				if toolName:find("gun") then return "Sheriff" end
			end
		end
	end
	
	return "Innocent"
end

local function getRoleColor(role)
	if role == "Murder" then return Color3.fromRGB(255, 50, 50)
	elseif role == "Sheriff" then return Color3.fromRGB(50, 100, 255)
	else return Color3.fromRGB(50, 255, 50) end
end

local function updateESP(targetPlayer)
	local objects = espObjects[targetPlayer]
	if not objects then return end
	
	local role = getPlayerRole(targetPlayer)
	local color = getRoleColor(role)
	
	if objects.Highlight and objects.Highlight.Parent then
		objects.Highlight.OutlineColor = color
		objects.Highlight.FillColor = color
	end
	
	if objects.NameLabel and objects.NameLabel.Parent then
		objects.NameLabel.Text = targetPlayer.Name .. " [" .. role .. "]"
		objects.NameLabel.TextColor3 = color
	end
	
	objects.CurrentRole = role
end

local function createESP(targetPlayer)
	if targetPlayer == player then return end
	
	if espObjects[targetPlayer] then
		local oldData = espObjects[targetPlayer]
		if oldData.Highlight and oldData.Highlight.Parent then
			updateESP(targetPlayer)
			return
		else
			if oldData.Highlight then oldData.Highlight:Destroy() end
			if oldData.BillboardGui then oldData.BillboardGui:Destroy() end
			if oldData.Connections then
				for _, connection in ipairs(oldData.Connections) do
					connection:Disconnect()
				end
			end
			espObjects[targetPlayer] = nil
		end
	end
	
	local character = targetPlayer.Character
	if not character then return end
	
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	local head = character:FindFirstChild("Head")
	local humanoid = character:FindFirstChild("Humanoid")
	
	if not humanoidRootPart or not head or not humanoid then return end
	
	local role = getPlayerRole(targetPlayer)
	local color = getRoleColor(role)
	
	local highlight = Instance.new("Highlight")
	highlight.Name = "ESP_Highlight"
	highlight.FillColor = color
	highlight.FillTransparency = 1
	highlight.OutlineColor = color
	highlight.OutlineTransparency = 0
	highlight.Adornee = character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = espFolder
	
	local billboardGui = Instance.new("BillboardGui")
	billboardGui.Name = "ESP_NameTag"
	billboardGui.Size = UDim2.new(0, 300, 0, 30)
	billboardGui.StudsOffset = Vector3.new(0, 2.5, 0)
	billboardGui.AlwaysOnTop = true
	billboardGui.MaxDistance = 1000
	billboardGui.Adornee = head
	billboardGui.Parent = espFolder
	
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 1, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.Text = targetPlayer.Name .. " [" .. role .. "]"
	nameLabel.TextColor3 = color
	nameLabel.TextSize = 14
	nameLabel.TextStrokeTransparency = 0.5
	nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	nameLabel.Parent = billboardGui
	
	local connections = {}
	
	table.insert(connections, humanoid.Died:Connect(function()
		removeESP(targetPlayer)
	end))
	
	local function onToolChanged()
		task.wait(0.1)
		if espObjects[targetPlayer] then
			updateESP(targetPlayer)
		end
	end
	
	table.insert(connections, character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then onToolChanged() end
	end))
	
	table.insert(connections, character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") then onToolChanged() end
	end))
	
	local backpack = targetPlayer:FindFirstChild("Backpack")
	if backpack then
		table.insert(connections, backpack.ChildAdded:Connect(function(child)
			if child:IsA("Tool") then onToolChanged() end
		end))
		table.insert(connections, backpack.ChildRemoved:Connect(function(child)
			if child:IsA("Tool") then onToolChanged() end
		end))
	end
	
	espObjects[targetPlayer] = {
		Highlight = highlight,
		BillboardGui = billboardGui,
		NameLabel = nameLabel,
		Connections = connections,
		Character = character,
		CurrentRole = role,
	}
end

local function removeESP(targetPlayer)
	local objects = espObjects[targetPlayer]
	if not objects then return end
	
	if objects.Connections then
		for _, connection in ipairs(objects.Connections) do
			connection:Disconnect()
		end
	end
	
	if objects.Highlight then objects.Highlight:Destroy() end
	if objects.BillboardGui then objects.BillboardGui:Destroy() end
	
	espObjects[targetPlayer] = nil
end

local function removeAllESP()
	for targetPlayer, _ in pairs(espObjects) do
		removeESP(targetPlayer)
	end
end

local function toggleESP(state)
	espEnabled = state
	
	if state then
		for _, targetPlayer in ipairs(Players:GetPlayers()) do
			if targetPlayer ~= player then
				createESP(targetPlayer)
			end
		end
	else
