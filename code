-- ================== FLY ==================
local flyEnabled = false
local flyConnection = nil
local flySpeed = 50

local function toggleFly(state)
	flyEnabled = state
	
	if state then
		if player.Character then
			local humanoid = player.Character:FindFirstChild("Humanoid")
			local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
			
			if humanoid and rootPart then
				humanoid.PlatformStand = true
				
				flyConnection = RunService.Heartbeat:Connect(function()
					if not flyEnabled then
						flyConnection:Disconnect()
						return
					end
					
					if player.Character then
						local currentRoot = player.Character:FindFirstChild("HumanoidRootPart")
						local currentHumanoid = player.Character:FindFirstChild("Humanoid")
						
						if currentRoot and currentHumanoid then
							currentHumanoid.PlatformStand = true
							
							local moveDirection = Vector3.new(0, 0, 0)
							
							if UserInputService:IsKeyDown(Enum.KeyCode.W) then
								moveDirection = moveDirection + (workspace.CurrentCamera.CFrame.LookVector * Vector3.new(1, 0, 1)).Unit
							end
							if UserInputService:IsKeyDown(Enum.KeyCode.S) then
								moveDirection = moveDirection + (-workspace.CurrentCamera.CFrame.LookVector * Vector3.new(1, 0, 1)).Unit
							end
							if UserInputService:IsKeyDown(Enum.KeyCode.A) then
								moveDirection = moveDirection + (-workspace.CurrentCamera.CFrame.RightVector * Vector3.new(1, 0, 1)).Unit
							end
							if UserInputService:IsKeyDown(Enum.KeyCode.D) then
								moveDirection = moveDirection + (workspace.CurrentCamera.CFrame.RightVector * Vector3.new(1, 0, 1)).Unit
							end
							if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
								moveDirection = moveDirection + Vector3.new(0, 1, 0)
							end
							if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
								moveDirection = moveDirection + Vector3.new(0, -1, 0)
							end
							
							if moveDirection.Magnitude > 0 then
								currentRoot.Velocity = moveDirection.Unit * flySpeed
							else
								currentRoot.Velocity = Vector3.new(0, 0, 0)
							end
						end
					end
				end)
			end
		end
	else
		if player.Character then
			local humanoid = player.Character:FindFirstChild("Humanoid")
			if humanoid then humanoid.PlatformStand = false end
		end
		
		if flyConnection then
			flyConnection:Disconnect()
			flyConnection = nil
		end
	end
end

-- ================== TELEPORT ФУНКЦИИ ==================
local function teleportToPlayer()
	local otherPlayers = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			table.insert(otherPlayers, p)
		end
	end
	
	if #otherPlayers > 0 then
		local randomPlayer = otherPlayers[math.random(1, #otherPlayers)]
		if player.Character then
			player.Character:MoveTo(randomPlayer.Character.HumanoidRootPart.Position)
			print("[rmk Hub] Телепорт к игроку: " .. randomPlayer.Name)
		end
	else
		print("[rmk Hub] Нет доступных игроков для телепорта")
	end
end

